{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mizanconsult",
  "main": "packages/router/src/index.ts",
  "compatibility_date": "2026-09-04",
  "keep_vars": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "mizanconsult-backend"
    },
    {
      "binding": "GATEKEEPER_CONTEXT",
      "service": "mizanconsult-gk-context"
    },
    {
      "binding": "GATEKEEPER_SCHEDULER",
      "service": "mizanconsult-gk-scheduler"
    },
    {
      "binding": "GATEKEEPER_WEBSEARCH",
      "service": "mizanconsult-gk-websearch"
    },
    {
      "binding": "GATEKEEPER_GITHUB",
      "service": "mizanconsult-github-connector"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./packages/workshop-frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*"
    ]
  }
}

{
  "name": "mizanconsult-github-connector",
  "main": ".wrangler/validate/src/github.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "nodejs_als"
  ],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BASE_URL": "https://manage.mizanconsult.com/gatekeeper/github",
    "WEBHOOK_ORIGIN": "https://manage.mizanconsult.com"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt",
        "**/*.svg"
      ],
      "fallthrough": false
    }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "UserAccount",
        "GitHubGatekeeperImpl"
      ]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GitHubHookDriver"
      ]
    }
  ]
}
